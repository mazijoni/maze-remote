# systemd unit for the Raspberry Pi.
# sudo cp maze-remote.service /etc/systemd/system/ && sudo systemctl enable --now maze-remote
[Unit]
Description=Maze Remote signaling server
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/maze-remote/server
EnvironmentFile=/home/pi/maze-remote/server/.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
